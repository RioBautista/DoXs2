PORT=8080
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-long-random-secret

# Auth mode
DEV_LOGIN_MOCK=false
AUTH_MODE=drupal-mysql
DEFAULT_CLIENT_SLUG=oxford

# Fallback/default MySQL auth config. Keep real values only in Secret Manager or local .env, never in git/chat.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=drupal_read_auth_user
MYSQL_PASSWORD=replace-with-secret
MYSQL_DATABASE=drupal_database
MYSQL_TABLE_PREFIX=

# Per-client override pattern for <client>.idoxs.app, example: oxford.idoxs.app
# IDOXS_CLIENT_OXFORD_MYSQL_HOST=127.0.0.1
# IDOXS_CLIENT_OXFORD_MYSQL_PORT=3306
# IDOXS_CLIENT_OXFORD_MYSQL_USER=drupal_read_auth_user
# IDOXS_CLIENT_OXFORD_MYSQL_PASSWORD=replace-with-secret
# IDOXS_CLIENT_OXFORD_MYSQL_DATABASE=drupal_database
# IDOXS_CLIENT_OXFORD_MYSQL_TABLE_PREFIX=
