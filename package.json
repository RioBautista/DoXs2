{
  "name": "doxs-modern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -ws",
    "typecheck": "npm run typecheck -ws",
    "lint": "npm run lint -ws",
    "seed:reports": "node scripts/seed-report-definitions.mjs",
    "seed:reports:dry-run": "node scripts/seed-report-definitions.mjs --dry-run"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0"
  }
}
