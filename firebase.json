{
  "functions": {
    "source": "apps/api",
    "runtime": "nodejs22",
    "codebase": "doxs-api",
    "predeploy": [
      "npm run build -w @doxs/api"
    ]
  },
  "hosting": {
    "target": "doccs-as",
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "doxs-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
